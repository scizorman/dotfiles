{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/git-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/session-start-jst-date.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
